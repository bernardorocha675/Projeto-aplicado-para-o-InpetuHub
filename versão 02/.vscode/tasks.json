{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "InPETU: configurar tudo",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/configurar.sh"
      ],
      "windows": {
        "command": "cmd.exe",
        "args": [
          "/d",
          "/c",
          "configurar.bat"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "InPETU: executar",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/iniciar.sh"
      ],
      "windows": {
        "command": "cmd.exe",
        "args": [
          "/d",
          "/c",
          "iniciar.bat"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "InPETU: testar",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/maven.sh",
        "-B",
        "-ntp",
        "test"
      ],
      "windows": {
        "command": "cmd.exe",
        "args": [
          "/d",
          "/c",
          "maven.bat",
          "-B",
          "-ntp",
          "test"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "InPETU: gerar JAR",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/maven.sh",
        "-B",
        "-ntp",
        "clean",
        "package"
      ],
      "windows": {
        "command": "cmd.exe",
        "args": [
          "/d",
          "/c",
          "maven.bat",
          "-B",
          "-ntp",
          "clean",
          "package"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
