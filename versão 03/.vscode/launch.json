{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "InPETU Hub (banco local)",
      "request": "launch",
      "mainClass": "br.com.inpetu.hub.InpetuApplication",
      "projectName": "inpetu-hub",
      "cwd": "${workspaceFolder}",
      "args": "--spring.profiles.active=local",
      "console": "integratedTerminal"
    },
    {
      "type": "java",
      "name": "InPETU Hub (produção TLS/MySQL)",
      "request": "launch",
      "mainClass": "br.com.inpetu.hub.InpetuApplication",
      "projectName": "inpetu-hub",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "args": "--spring.profiles.active=prod",
      "console": "integratedTerminal"
    }
  ]
}
